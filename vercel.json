{
  "trailingSlash": true,
  "cleanUrls": true,
  "headers": [
    { "source": "/desk/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/gallery/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/gallery/videos.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/for/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
